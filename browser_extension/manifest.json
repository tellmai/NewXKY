{
  "manifest_version": 3,
  "name": "NewXKY 网页直连",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "将当前答题标签页连接到本机 NewXKY，无需移动系统鼠标。",
  "permissions": ["activeTab", "scripting", "debugger", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "连接 NewXKY 答题页", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"}
}
